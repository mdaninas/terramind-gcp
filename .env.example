# Local development only. Production environment is managed through Terraform.
PORT=8080
# Offline mode uses bounded process memory and makes no provider calls.
TERRAMIND_API_MODE=offline
REPORT_RETENTION_HOURS=24
ANALYSES_PER_MINUTE=6
# Set the approved isolated project before explicitly enabling cloud operations.
GCP_PROJECT_ID=terramind-synthetic-example
GCP_REGION=us-central1
FIRESTORE_DATABASE=terramind-dev
RUNBOOK_BUCKET=terramind-synthetic-example-terramind-dev-runbooks
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LOCATION=global
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_LOCATION=us-central1
EXPLANATION_LANGUAGE=en
# Optional separate Eventarc receiver. Keep disabled until an approved cloud activation.
TERRAMIND_SERVICE=analysis
TERRAMIND_EVENTARC_MODE=disabled
