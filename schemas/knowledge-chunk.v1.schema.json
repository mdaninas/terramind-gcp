{
  "additionalProperties": false,
  "properties": {
    "chunk_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Chunk Hash",
      "type": "string"
    },
    "chunk_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Chunk Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "doc_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
      "title": "Doc Id",
      "type": "string"
    },
    "section_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
      "title": "Section Id",
      "type": "string"
    },
    "source_path": {
      "pattern": "^(runbooks|incidents)/[a-z0-9-]+\\.md$",
      "title": "Source Path",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "text": {
      "maxLength": 3200,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "chunk_id",
    "doc_id",
    "title",
    "version",
    "source_path",
    "content_hash",
    "section_id",
    "chunk_hash",
    "text"
  ],
  "title": "Chunk",
  "type": "object"
}
